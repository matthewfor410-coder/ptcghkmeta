// /api/taiwan.js - Vercel Serverless Function
// 代理 asia.pokemon-card.com Trainers Website 台灣/香港道館賽數據

export default async function handler(req, res) {
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET, OPTIONS');
  if (req.method === 'OPTIONS') return res.status(200).end();

  const { region = 'tw', limit = '50' } = req.query; // tw / hk

  try {
    // Asia Trainers Website 結構：
    // Event Search: https://asia.pokemon-card.com/tw/event-search/ 或 /api/event
    // 嘗試多個可能 endpoint，失敗就回失敗（唔出假數據）

    const endpointsToTry = [
      `https://asia.pokemon-card.com/tw/api/event?limit=${limit}`,
      `https://asia.pokemon-card.com/hk/api/event?limit=${limit}`,
      `https://asia.pokemon-card.com/tw/event-search/`,
      `https://asia.pokemon-card.com/api/events?country=${region}`
    ];

    let lastError = null;
    for (const url of endpointsToTry) {
      try {
        const resp = await fetch(url, {
          headers: {
            'User-Agent': 'Mozilla/5.0 (PTCG-Meta-Tracker)',
            'Accept': 'application/json, text/html, */*',
            'Referer': 'https://asia.pokemon-card.com/'
          }
        });

        if (!resp.ok) {
          lastError = `HTTP ${resp.status} @ ${url}`;
          continue;
        }

        const contentType = resp.headers.get('content-type') || '';
        let data;

        if (contentType.includes('json')) {
          data = await resp.json();
        } else {
          const html = await resp.text();
          // 若是 HTML，嘗試抽取 Event 列表
          if (html.length < 1000) {
            lastError = `HTML太短 @ ${url}`;
            continue;
          }
          // 簡單 Regex 抽取活動名
          const eventRegex = /(Town League|City League|Regional|Premier Ball|道館賽|聯盟賽)[^<]{0,50}/gi;
          const events = [];
          let m;
          while ((m = eventRegex.exec(html)) !== null && events.length < parseInt(limit)) {
            events.push(m[0].trim());
          }
          if (events.length === 0) {
            lastError = `解析到0個活動 @ ${url}`;
            continue;
          }
          return res.status(200).json({
            success: true,
            source: `asia.pokemon-card.com (${url})`,
            region,
            totalEvents: events.length,
            events: events.map((name, i) => ({ id: i+1, name, region })),
            note: '從 HTML 解析，需進一步爬詳細成績',
            rawUrl: url
          });
        }

        // 若是 JSON
        if (data) {
          return res.status(200).json({
            success: true,
            source: `asia.pokemon-card.com (${url})`,
            region,
            totalEvents: Array.isArray(data) ? data.length : (data.events?.length || 0),
            rawData: data,
            rawUrl: url
          });
        }

      } catch (e) {
        lastError = `${e.message} @ ${url}`;
        continue;
      }
    }

    // 全部 endpoint 都失敗
    return res.status(502).json({
      success: false,
      error: `無法取得台灣官方數據 - 全部 endpoint 失敗`,
      lastError,
      tried: endpointsToTry,
      source: 'asia.pokemon-card.com',
      hint: '官方 Trainers Website 可能需登入或改用 https://asia.pokemon-card.com/tw/event/ 手動爬。建議用 Puppeteer 或改爬 Facebook 群組 PTCG Taiwan',
      alternative: [
        '1. 手動去 https://asia.pokemon-card.com/tw/event-search/ 睇道館賽',
        '2. 用 Facebook Graph API 爬 PTCG Taiwan 群組',
        '3. 先用 Limitless 台灣關鍵字過濾頂住'
      ]
    });

  } catch (e) {
    return res.status(500).json({
      success: false,
      error: `Taiwan 爬蟲失敗: ${e.message}`,
      source: 'asia.pokemon-card.com'
    });
  }
}

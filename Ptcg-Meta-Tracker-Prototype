import asyncio
from playwright.async_api import async_playwright
import httpx
from supabase import create_client
import os

LIMITLESS_API = "https://play.limitlesstcg.com/api/tournaments"
SUPABASE_URL = os.getenv("SUPABASE_URL")
SUPABASE_KEY = os.getenv("SUPABASE_KEY")

async def fetch_real_tournaments():
    """V2: 直接呼叫官方公開 API，無需 Key"""
    async with httpx.AsyncClient(timeout=30) as client:
        try:
            res = await client.get(
                LIMITLESS_API,
                params={"game": "PTCG", "format": "STANDARD", "limit": 20},
                headers={"Accept": "application/json"}
            )
            res.raise_for_status()
            data = res.json()
            tournaments = data if isinstance(data, list) else data.get("tournaments", [])
            print(f"[Collector] 抓到 {len(tournaments)} 場真實比賽")
            return tournaments
        except Exception as e:
            print(f"[Collector] API 失敗，嘗試 Playwright 備援: {e}")
            return await fallback_scrape()

async def fetch_standings(tournament_id: str):
    """V2 新增: 抓 Top8 與 Deck 分佈"""
    url = f"{LIMITLESS_API}/{tournament_id}/standings"
    async with httpx.AsyncClient() as client:
        r = await client.get(url)
        if r.status_code == 200:
            standings = r.json()
            # 解析 deck.name 做 breakdown
            decks = [s.get("deck", {}).get("name") for s in standings]
            print(f"[Collector] {tournament_id} - {len(decks)} decks")
            return standings
        return []

def save_to_supabase(tournaments):
    supabase = create_client(SUPABASE_URL, SUPABASE_KEY)
    for t in tournaments:
        supabase.table("tournaments").upsert({
            "id": t["id"],
            "name": t["name"],
            "date": t["date"],
            "players": t.get("playerCount", 0),
            "source": "limitless"
        }).execute()

# GitHub Actions: 每6小時執行
# .github/workflows/collect.yml -> python collector/limitless.py
if __name__ == "__main__":
